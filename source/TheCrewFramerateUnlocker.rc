#include <windows.h>
#include "ReleaseVersion.h"

#ifdef BUILD_PROXY
#define FILE_DESCRIPTION "TheCrewFramerateUnlocker XInput 1.3 proxy and ASI loader"
#define ORIGINAL_FILENAME "xinput1_3.dll"
#define INTERNAL_NAME "TheCrewFramerateUnlocker.XInputProxy"
#elif defined(BUILD_ADVANCED_GRAPHICS)
#define FILE_DESCRIPTION "TheCrewFramerateUnlocker advanced graphics plugin for The Crew"
#define ORIGINAL_FILENAME "TheCrew.AdvancedGraphics.asi"
#define INTERNAL_NAME "TheCrew.AdvancedGraphics"
#elif defined(BUILD_SKIP_INTRO)
#define FILE_DESCRIPTION "TheCrewFramerateUnlocker intro skip plugin for The Crew"
#define ORIGINAL_FILENAME "TheCrew.SkipIntro.asi"
#define INTERNAL_NAME "TheCrew.SkipIntro"
#else
#define FILE_DESCRIPTION "TheCrewFramerateUnlocker framerate and vehicle motion plugin for The Crew"
#define ORIGINAL_FILENAME "TheCrew.FramerateUnlocker.asi"
#define INTERNAL_NAME "TheCrew.FramerateUnlocker"
#endif

1 VERSIONINFO
 FILEVERSION PRODUCT_VERSION
 PRODUCTVERSION PRODUCT_VERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", FILE_DESCRIPTION
            VALUE "FileVersion", PRODUCT_VERSION_STRING
            VALUE "InternalName", INTERNAL_NAME
            VALUE "OriginalFilename", ORIGINAL_FILENAME
            VALUE "ProductName", "TheCrewFramerateUnlocker"
            VALUE "ProductVersion", PRODUCT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
